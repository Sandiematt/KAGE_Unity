+def inpaint(lab, hole, source, mode='vertical', reach_px=INPAINT_REACH):
+    """Fills `hole` pixels with labels from `source` along the cloth grain, with 2D nearest-source fallback."""
+    reach = int(round(reach_px * S))
+    if mode == 'vertical':
+        out = _inpaint_1d(lab, hole, source, reach)
+    elif mode == 'horizontal':
+        out = _inpaint_1d(lab.T, hole.T, source.T, reach).T
+    else:
+        out = np.full(lab.shape, -1, np.int16)
+
+    # 2D nearest-source fallback for remaining uncovered hole pixels (e.g. diagonal edges or wide occlusions)
+    rem = (hole == 1) & (out < 0)
+    if rem.any() and source.any():
+        dist, nearest = cv2.distanceTransformWithLabels(
+            (source == 0).astype(np.uint8), cv2.DIST_L2, 5, labelType=cv2.DIST_LABEL_PIXEL
+        )
+        sy, sx = np.nonzero(source)
+        ok = rem & (dist <= reach)
+        if ok.any():
+            idx = nearest[ok] - 1
+            out[ok] = lab[sy[idx], sx[idx]]
+    return out
