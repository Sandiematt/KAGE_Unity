                     (100, 992), (94, 1006), (100, 1021), (120, 1021), (140, 1020), (160, 1005), (180, 990), (200, 974),
                     (220, 959), (240, 944), (260, 928), (280, 913), (300, 898), (320, 882), (340, 867), (350, 859),
